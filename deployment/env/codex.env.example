# Generated with scripts/configure_nas.py or configure_codex.py; keep private.
# Only the runner loads this file. No database, JWT, SMTP or messaging keys.
CODEX_RUNNER_TOKEN=<same-independent-runner-secret-as-api-and-worker>
CODEX_HOME=/home/appuser/.codex
CODEX_PATH=/usr/local/bin/codex
CODEX_TIMEOUT_SECONDS=90
CODEX_CHAT_TIMEOUT_SECONDS=900
CODEX_RUNNER_MAX_CONCURRENT=2
# Optional: match CODEX_MODEL in API and Worker. Blank uses the CLI default.
CODEX_MODEL=
# Optional dedicated public-research model; match the Worker if configured.
DAILY_RESEARCH_MODEL=
