# Copy to api.env (git-ignored) and inject secrets from the deployment platform.
APP_ENV=production
DATABASE_URL=postgresql://wealthsail_api_login:<independent-generated-secret>@db.example/wealthsail
JWT_SECRET=<generated-32-byte-or-longer-secret>
REFRESH_TOKEN_HMAC_KEY=<independent-generated-secret>
BINDING_HMAC_KEY=<independent-generated-secret>
WECOM_CALLBACK_TOKEN=<wecom-callback-token>
WECOM_CALLBACK_AES_KEY=<43-character-wecom-aes-key>
WECOM_CORP_ID=<wecom-corp-id>
ROUTING_ENCRYPTION_KEY=<api-encryption-key-for-callback-binding-write>
CORS_ORIGINS=["https://wealthsail.example.com"]
TIANTIAN_IMPORT_ENABLED=true
TIANTIAN_IMPORT_MAX_UPLOAD_BYTES=20971520
TIANTIAN_IMPORT_MAX_EXPANDED_BYTES=104857600
TIANTIAN_IMPORT_MAX_ENTRIES=20
TIANTIAN_IMPORT_MAX_COMPRESSION_RATIO=100
TIANTIAN_IMPORT_MAX_POSITIONS=1000
TIANTIAN_IMPORT_MAX_TRANSACTIONS=20000
TIANTIAN_IMPORT_MAX_JSON_DEPTH=32
TIANTIAN_IMPORT_MAX_TEXT_LENGTH=2000
AUTH_DEV_MODE=false
