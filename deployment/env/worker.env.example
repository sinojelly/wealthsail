# Copy to worker.env (git-ignored). Do not copy API JWT/refresh/callback secrets.
APP_ENV=production
# NAS direct connection; the API and Worker passwords must be different.
WORKER_DATABASE_URL=postgresql://wealthsail_worker_login:<independent-generated-secret>@postgres:5432/wealthsail?sslmode=disable
WORKER_DATABASE_POOL_MODE=direct
WECOM_ENABLED=true
ROUTING_ENCRYPTION_KEY=<same-envelope-key-version-used-by-api-callback>
CODEX_RUNNER_URL=http://codex-runner:8090
CODEX_RUNNER_TOKEN=<same-independent-runner-secret-as-api-and-codex>
CODEX_TIMEOUT_SECONDS=90
CODEX_CHAT_TIMEOUT_SECONDS=900
CODEX_MODEL=
WECOM_CORP_ID=<wecom-corp-id>
WECOM_CORP_SECRET=<wecom-application-secret>
WECOM_AGENT_ID=<wecom-agent-id>
WECOM_BOT_ID=
WECOM_BOT_SECRET=
# Independent shared-data refresh; the enabled AI pipeline collects its
# own public batch regardless of ALPHA_PUBLIC_ENABLED (no parallel morning loop).
# ALPHA_OPPORTUNITY_ENABLED also constrains the scoped 14:30 OTC digest.
# Put a real group webhook only in this Worker env; never in api.env or Git.
ALPHA_PUBLIC_ENABLED=true
ALPHA_OPPORTUNITY_ENABLED=true
WECOM_OPPORTUNITY_WEBHOOK_URL=
OPPORTUNITY_TENANT_ID=
OPPORTUNITY_USER_ID=
# One public-data -> AI research pipeline, always in Asia/Shanghai.
DAILY_RESEARCH_ENABLED=false
DAILY_RESEARCH_MANUAL_ENABLED=false
# DAILY includes weekends; WEEKDAYS means Monday-Friday, without holiday adjustments.
DAILY_RESEARCH_SCHEDULE_MODE=DAILY
DAILY_RESEARCH_SCHEDULE_TIME=07:00
DAILY_RESEARCH_START_WINDOW_MINUTES=120
DAILY_RESEARCH_PIPELINE_TIMEOUT_SECONDS=7200
# Legacy 08:30/08:35 reports and AI-result pushes remain separately disabled.
PRE_MARKET_REPORTS_ENABLED=false
MORNING_OPPORTUNITY_PUSH_ENABLED=false
DAILY_RESEARCH_AUDIT_DIR=/app/data/research-audit
FUND_1430_ENABLED=false
POST_MARKET_REVIEW_ENABLED=false
# Five-minute holdings anomaly checks and alerts; independent of daily research.
INTRADAY_TRACKING_ENABLED=false
DATA_TASK_POLL_INTERVAL_SECONDS=5
DATA_TASK_CONCURRENCY=2
DATA_TASK_LEASE_SECONDS=300
DATA_TASK_MAX_ATTEMPTS=5
DATA_TASK_BASE_BACKOFF_SECONDS=10
JOB_RECOVERY_WINDOW_MINUTES=30
JOB_RECOVERY_MAX_ATTEMPTS=5
FUND_NAV_HISTORY_PAGE_SIZE=100
FUND_NAV_HISTORY_MAX_PAGES=50
AUTH_DEV_MODE=false
