# Copy to worker.env (git-ignored). Do not copy API JWT/refresh/callback secrets.
APP_ENV=production
WORKER_DATABASE_URL=postgresql://worker-login:<generated-secret>@db.example/wealthsail
ROUTING_ENCRYPTION_KEY=<same-envelope-key-version-used-by-api-callback>
MODEL_API_KEY=<model-provider-key>
WECOM_CORP_ID=<wecom-corp-id>
WECOM_CORP_SECRET=<wecom-application-secret>
WECOM_AGENT_ID=<wecom-agent-id>
WECOM_BOT_ID=
WECOM_BOT_SECRET=
AUTH_DEV_MODE=false
