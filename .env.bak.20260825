# ============================================================
# Supabase Session Pooler（生产 / 容器化部署，docker-compose 使用）
# 事务模式 PgBouncer（端口 6543）不支持 Prepared Statements，DSN 必须带
# statement_cache_size=0（asyncpg 从 DSN query 参数自动解析）。
# 部署前在 Supabase Dashboard → Connect → Session pooler 获取真实值替换
# <PROJECT-REF>/<PASSWORD>/<REGION>，并先在目标库执行
# scripts/local_supabase_compat.sql 与 migrations/*.sql。
# 本地开发继续使用下方 DATABASE_URL（本地 Postgres 5433，直连模式）。
# ============================================================
SUPABASE_POOLER_DATABASE_URL="postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require&statement_cache_size=0"
SUPABASE_POOLER_WORKER_DATABASE_URL="postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require&statement_cache_size=0"

# =============================================================================
# WealthSail local development environment (git-ignored)
# Production deploys must override every secret via api.env / worker.env
# (see docs/10 §8.1). Values below are LOCAL-DEV fallbacks only.
# =============================================================================
APP_ENV=development
LOG_LEVEL=INFO

# Local Postgres 16 runs on port 5433 (see scripts/local_supabase_compat.sql);
# point DATABASE_URL at your Supabase pooler in production.
DATABASE_URL=postgresql://wealthsail_user:dev_password_123@localhost:5432/wealthsail_dev
/wealthsail_dev
WORKER_DATABASE_URL=postgresql://wealthsail_user:dev_password_123@localhost:5432/wealthsail_dev

JWT_SECRET=dev-only-jwt-secret-change-me
AUTH_DEV_MODE=false

# DeepSeek model gateway — leave MODEL_API_KEY empty to use the deterministic
# report fallback (model runs are recorded as ABSTAINED).
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_API_KEY=sk-3a78d2a0255b4d3a9f2b6f7f0db2d277
MODEL_NAME=deepseek-chat

# WeCom callback / binding (dev placeholders)
WECOM_CALLBACK_TOKEN=dev-wecom-callback-token
WECOM_CALLBACK_AES_KEY=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8
WECOM_CORP_ID=ww-dev-corp-id
WECOM_CORP_SECRET=
WECOM_AGENT_ID=1000002
BINDING_HMAC_KEY=dev-binding-hmac-key-change-me
ROUTING_ENCRYPTION_KEY=dev-routing-key-32-bytes-minimum!
