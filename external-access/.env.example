# Non-secret settings only. All three Compose invocations must use these same
# network names and connector IPs. Check NAS Docker/LAN subnet conflicts first.
# The Tunnel token belongs in secrets/cloudflared-token, never in this file.
WEALTH_EDGE_NETWORK=wealthsail-tunnel-edge
WEALTH_EDGE_SUBNET=172.30.91.0/29
WEALTH_EDGE_IP_RANGE=172.30.91.4/30
CLOUDFLARED_WEALTH_IP=172.30.91.2

STUDYOS_EDGE_NETWORK=studyos-tunnel-edge
STUDYOS_EDGE_SUBNET=172.30.92.0/29
STUDYOS_EDGE_IP_RANGE=172.30.92.4/30
CLOUDFLARED_STUDYOS_IP=172.30.92.2

# Application overlays remove host port bindings; access is through the Tunnel.
STUDYOS_ALLOWED_HOSTS=studyos.sinojelly.kdns.fr
